# ----- PostgreSQL -----
POSTGRES_USER=mieventos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mieventos

# URL de conexión usada por el backend (driver psycopg2)
DATABASE_URL=postgresql+psycopg2://mieventos:changeme@db:5432/mieventos

# ----- Frontend -----
# Base URL que el cliente usa para llamar a la API (vía proxy de Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ----- Auth & RBAC -----
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ----- Hardening -----
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT=5/minute
LOG_LEVEL=ERROR
